"""
Melody Killa Enhance  v2.0 - melody magic
FL Studio piano roll script (FL Studio 21+)

Install:
  Copy this file to:
  Documents\\Image-Line\\FL Studio\\Settings\\Piano roll scripts\\
  Then in the piano roll: Tools (wrench) -> Scripting -> Melody Killa Enhance

Usage:
  - Write anything - even just a rhythm on one note (e.g. everything on C5).
  - Turn the "Magic" knob - every number = a new melody. Same number = same
    result, so you can always go back to one you liked.
  - Regenerate = another new melody on the same Magic number.
  - The other knobs fine-tune the new melody without changing the magic.
  - Accept = the notes stay in the piano roll and you can keep editing them.
  - If you select only some notes, only those are changed.
  - All knobs at 0 = the original melody.
  - Made for monophonic melodies (leads) - overlapping notes get shortened.
"""
import flpianoroll as flp

# ----------------------------------------------------------------- data
SCALES = {
    'Natural Minor':  [0, 2, 3, 5, 7, 8, 10],
    'Harmonic Minor': [0, 2, 3, 5, 7, 8, 11],
    'Phrygian':       [0, 1, 3, 5, 7, 8, 10],
    'Dorian':         [0, 2, 3, 5, 7, 9, 10],
    'Major':          [0, 2, 4, 5, 7, 9, 11],
}
SCALE_NAMES = list(SCALES.keys())
SCALE_OPTS = ['Auto'] + SCALE_NAMES
KEY_NAMES = ['Auto', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
HARMONY = ['Off', 'Third above', 'Fifth below', 'Octave below']

PROPS = ['number', 'time', 'length', 'velocity', 'pan', 'release', 'color',
         'fcut', 'fres', 'pitchofs', 'slide', 'porta', 'muted', 'group']


# ----------------------------------------------------------------- utils
class Rng:
    """Deterministic xorshift - same Magic = same result."""
    def __init__(self, seed):
        self.s = (seed * 2654435761 + 12345) & 0xFFFFFFFF or 1

    def next(self):
        x = self.s
        x ^= (x << 13) & 0xFFFFFFFF
        x ^= x >> 17
        x ^= (x << 5) & 0xFFFFFFFF
        self.s = x & 0xFFFFFFFF
        return self.s / 4294967296.0

    def chance(self, p):
        return self.next() < p

    def pick(self, seq):
        return seq[int(self.next() * len(seq)) % len(seq)]

    def randint(self, a, b):
        return a + int(self.next() * (b - a + 1)) % (b - a + 1)


def clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


def snapshot(n):
    d = {}
    for p in PROPS:
        try:
            d[p] = getattr(n, p)
        except Exception:
            pass
    return d


def make_note(d):
    n = flp.Note()
    for p in PROPS:
        if p in d:
            try:
                setattr(n, p, d[p])
            except Exception:
                pass
    return n


def variant(d, **kw):
    x = dict(d)
    x.update(kw)
    return x


def detect_key(notes, roots=None, scales=None):
    """Find the key + scale the notes fit best (weighted by length).
    roots / scales restrict the search (e.g. fixed key, auto scale)."""
    roots = list(range(12)) if roots is None else roots
    scales = SCALE_NAMES if scales is None else scales
    best, best_root, best_scale = None, roots[0], scales[0]
    first_pc = notes[0]['number'] % 12
    last_pc = notes[-1]['number'] % 12
    avg = sum(max(1, n['length']) for n in notes) / float(len(notes))
    for name in scales:
        for root in roots:
            pcs = set((root + i) % 12 for i in SCALES[name])
            score = 0
            for n in notes:
                pc = n['number'] % 12
                w = max(1, n['length'])
                score += w if pc in pcs else -2 * w
                if pc == root:
                    score += avg * 0.5
            if first_pc == root:
                score += avg * 2
            if last_pc == root:
                score += avg
            if best is None or score > best:
                best, best_root, best_scale = score, root, name
    return best_root, best_scale


def scale_pitches(root, scale):
    iv = set(SCALES[scale])
    return [p for p in range(128) if (p - root) % 12 in iv]


def idx_of(pitches, p):
    bi, bd = 0, 999
    for i, q in enumerate(pitches):
        d = abs(q - p)
        if d < bd:
            bi, bd = i, d
    return bi


def step(pitches, p, k):
    return pitches[clamp(idx_of(pitches, p) + k, 0, len(pitches) - 1)]


# ----------------------------------------------------------------- dialog
KNOBS = ['Magic', 'Magic amount', 'Range', 'Rhythm', 'Ornaments', 'Bounce',
         'Harmony', 'Key', 'Scale']
# FL re-runs apply() with unchanged knobs only when Regenerate is pressed.
_state = {'values': None, 'magic': None, 'regen': 0}


def createDialog():
    _state.update(values=None, magic=None, regen=0)  # fresh start on open
    form = flp.ScriptDialog(
        'Melody Killa Enhance',
        'Conjures new melodies from your melody. Turn the Magic knob until '
        'you hear the one (or press Regenerate), then fine-tune it with the '
        'other knobs. '
        'Everything at 0 = original.')
    form.AddInputKnobInt('Magic', 1, 1, 999)
    form.AddInputKnob('Magic amount', 0.7, 0, 1)
    form.AddInputKnob('Range', 0.4, 0, 1)
    form.AddInputKnob('Rhythm', 0, -1, 1)
    form.AddInputKnob('Ornaments', 0.3, 0, 1)
    form.AddInputKnob('Bounce', 0.3, 0, 1)
    form.AddInputCombo('Harmony', ','.join(HARMONY), 0)
    form.AddInputCombo('Key', ','.join(KEY_NAMES), 0)
    form.AddInputCombo('Scale', ','.join(SCALE_OPTS), 0)
    return form


# ----------------------------------------------------------------- magic: pitches
def magic_pitches(src, pitches, root, scale, ppq, strength, spread, rng):
    """New pitch line over the original rhythm.
    Call / response form: odd segments (bars) start like the previous motif
    and end differently, even segments repeat the motif from two back."""
    n = len(src)
    top = len(pitches) - 1
    orig = [idx_of(pitches, d['number']) for d in src]
    center = int(round(sum(orig) / float(n)))
    lim = 4 + int(round(spread * 6))           # max. scale degrees from center
    lo, hi = max(0, center - lim), min(top, center + lim)

    iv = SCALES[scale]
    chord_pcs = set((root + iv[k]) % 12 for k in (0, 2, 4))

    def is_chord(i):
        return (pitches[i] - root) % 12 in chord_pcs

    def near(i, test):
        for off in (0, 1, -1, 2, -2, 3, -3):
            j = i + off
            if lo <= j <= hi and test(j):
                return j
        return i

    def reflect(i):
        if i > hi:
            i = hi - (i - hi)
        if i < lo:
            i = lo + (lo - i)
        return clamp(i, lo, hi)

    start = src[0]['time']
    total = max(d['time'] + d['length'] for d in src) - start
    bar = 4 * ppq
    seg = bar if total >= 2 * bar else max(ppq, total // 2)
    seg_of = [(d['time'] - start) // seg for d in src]
    nseg = seg_of[-1] + 1
    repeat = [s >= 1 and rng.chance(0.85 * strength) for s in range(nseg)]

    gen = [0] * n
    prev = None
    for i, d in enumerate(src):
        s = seg_of[i]
        rel = d['time'] - start - s * seg

        # --- repeat motif from an earlier segment
        answer = s % 2 == 1
        if repeat[s] and not (answer and rel >= seg // 2):
            ref = s - 1 if s == 1 else s - 2
            cands = [k for k in range(i) if seg_of[k] == ref]
            if cands:
                k = min(cands, key=lambda k: abs(src[k]['time'] - start
                                                  - ref * seg - rel))
                gen[i] = prev = gen[k]
                continue

        # --- random walk on the scale
        if prev is None:
            deg = orig[i]
            if rng.chance(strength):
                deg = near(clamp(center + rng.randint(-2, 2), lo, hi), is_chord)
        else:
            od = orig[i] - orig[i - 1]
            # repeated note in the original (e.g. all C5) -> move more often
            p_move = strength if od != 0 else min(1.0, strength * 1.3)
            if rng.chance(p_move):
                if od != 0 and rng.chance(0.5):
                    dirn = 1 if od > 0 else -1      # remember original direction
                else:
                    dirn = rng.pick([1, -1])
                r = rng.next()
                if r < 0.15 * (1 - spread):
                    size = 0
                elif r < 0.7 - 0.35 * spread:
                    size = 1
                elif r < 0.9 - 0.3 * spread:
                    size = 2
                else:
                    size = rng.randint(3, 4 + int(spread * 3))
                if rng.chance(0.12 * spread):
                    size = 7                        # octave leap
                deg = reflect(prev + dirn * size)
            else:
                deg = clamp(prev + od, 0, top)      # original interval

        # strong beat -> chord tone
        if (d['time'] - start) % ppq == 0 and rng.chance(0.6 * strength):
            deg = near(deg, is_chord)
        gen[i] = prev = deg

    # end on the tonic
    if rng.chance(0.8 * strength):
        gen[-1] = near(gen[-1], lambda j: pitches[j] % 12 == root)

    return [variant(d, number=pitches[gen[i]]) for i, d in enumerate(src)]


# ----------------------------------------------------------------- magic: rhythm
def magic_rhythm(src, amount, pitches, ppq, rng):
    """amount > 0: chop notes into short hits, amount < 0: long sustained notes."""
    out = []
    if amount > 0:
        for d in src:
            L, t = d['length'], d['time']
            if L >= ppq // 2 and rng.chance(amount):
                piece = ppq // 4 if (L < ppq or rng.chance(amount)) else ppq // 2
                piece = max(1, piece)
                count = min(8, L // piece)
                for j in range(count):
                    p = d['number']
                    if j > 0 and rng.chance(0.35):
                        p = step(pitches, p, rng.pick([1, -1, 2, -2]))
                    ln = piece if j < count - 1 else L - j * piece
                    out.append(variant(d, number=p, time=t + j * piece, length=ln))
            else:
                out.append(dict(d))
    else:
        a = -amount
        i = 0
        while i < len(src):
            d = dict(src[i])
            j = i + 1
            while (j < len(src) and d['length'] < 4 * ppq
                   and rng.chance(a * 0.7)):
                nx = src[j]
                d['length'] = max(d['length'], nx['time'] + nx['length'] - d['time'])
                j += 1
            out.append(d)
            i = j
        # legato - fill gaps up to the next note
        for k in range(len(out) - 1):
            gap_end = out[k + 1]['time']
            if gap_end > out[k]['time'] + out[k]['length'] and rng.chance(a):
                out[k]['length'] = gap_end - out[k]['time']
    return out


# ----------------------------------------------------------------- ornaments
def ornament(src, pitches, ppq, amt, rng):
    """Triplet runs, rolls and grace notes. More in the second half (response)."""
    p_trip = clamp(amt * 0.5, 0.0, 0.95)
    p_roll = clamp(amt * 0.4, 0.0, 0.95)
    p_grace = clamp(amt * 0.4, 0.0, 0.95)

    start = min(d['time'] for d in src)
    end = max(d['time'] + d['length'] for d in src)
    half = start + (end - start) // 2

    prev_run = False
    out = []  # every note has '_k': main / run / roll / grace
    for k, d in enumerate(src):
        nxt = None
        for j in range(k + 1, len(src)):
            if src[j]['time'] > d['time']:
                nxt = src[j]
                break

        boost = 1.4 if d['time'] >= half else 1.0
        pitch = d['number']
        vel = d.get('velocity', 0.8)
        t, L = d['time'], d['length']

        tl = max(1, ppq // 6)     # 1/16 triplet
        rstep = max(1, ppq // 4)  # 1/16
        done = False

        if amt > 0 and nxt is not None and L >= ppq // 2 and rng.chance(p_trip * boost):
            run_len = 3 * tl
            main_len = L - run_len
            if main_len >= ppq // 8:
                out.append(variant(d, length=main_len, _k='main'))
            ti = idx_of(pitches, nxt['number'])
            ci = idx_of(pitches, pitch)
            dirn = 1 if ti > ci else -1 if ti < ci else rng.pick([1, -1])
            for j in range(3):
                pi = clamp(ti - dirn * (3 - j), 0, len(pitches) - 1)
                out.append(variant(d,
                                   number=pitches[pi],
                                   time=t + L - run_len + j * tl,
                                   length=tl,
                                   velocity=clamp(vel * (0.6 + 0.1 * j), 0.05, 1.0),
                                   _k='run'))
            done = True

        elif amt > 0 and L >= ppq // 2 and rng.chance(p_roll * boost):
            count = rng.randint(2, 4)
            while count > 1 and L - count * rstep < rstep:
                count -= 1
            if count >= 2:
                for j in range(count):
                    out.append(variant(d,
                                       time=t + j * rstep,
                                       length=max(1, int(rstep * 0.9)),
                                       velocity=clamp(vel * (0.5 + 0.5 * j / count), 0.05, 1.0),
                                       _k='roll'))
                out.append(variant(d, time=t + count * rstep,
                                   length=L - count * rstep, _k='main'))
                done = True

        if not done:
            out.append(variant(d, _k='main'))
        ends_in_run = done and out[-1]['_k'] == 'run'

        # grace note before the note (not when a run already leads into it)
        gl = max(1, ppq // 8)  # 1/32
        if amt > 0 and t - gl >= 0 and not prev_run and rng.chance(p_grace * boost):
            out.append(variant(d,
                               number=step(pitches, pitch, rng.pick([1, -1])),
                               time=t - gl,
                               length=gl,
                               velocity=clamp(vel * 0.55, 0.05, 1.0),
                               _k='grace'))
        prev_run = ends_in_run
    return out


# ----------------------------------------------------------------- engine
def regen_count(form):
    """How many times Regenerate was pressed on the current Magic number."""
    values = [form.GetInputValue(k) for k in KNOBS]
    magic = values[0]
    if magic != _state['magic']:
        _state['regen'] = 0          # new Magic number -> its own melody
    elif values == _state['values']:
        _state['regen'] += 1         # nothing changed -> Regenerate
    _state['values'], _state['magic'] = values, magic
    return _state['regen']


def apply(form):
    # Magic 1..999 are fixed melodies, Regenerate moves past that range
    seed = int(form.GetInputValue('Magic')) + 1000 * regen_count(form)
    strength = float(form.GetInputValue('Magic amount'))
    spread = float(form.GetInputValue('Range'))
    rhythm = float(form.GetInputValue('Rhythm'))
    orn = float(form.GetInputValue('Ornaments'))
    bounce = float(form.GetInputValue('Bounce'))
    harm = int(form.GetInputValue('Harmony'))
    key_i = int(form.GetInputValue('Key'))
    scale_i = int(form.GetInputValue('Scale'))

    score = flp.score
    total = score.noteCount
    if total == 0:
        return
    if strength <= 0 and rhythm == 0 and orn <= 0 and bounce <= 0 and not harm:
        return  # everything at 0 = original

    ppq = score.PPQ

    # only selected notes, if any
    any_sel = False
    for i in range(total):
        if score.getNote(i).selected:
            any_sel = True
            break
    idxs = [i for i in range(total) if not any_sel or score.getNote(i).selected]
    src = [snapshot(score.getNote(i)) for i in idxs]
    for i in sorted(idxs, reverse=True):
        score.deleteNote(i)
    src.sort(key=lambda d: (d['time'], d['number']))

    roots = None if key_i == 0 else [key_i - 1]
    scales = None if scale_i == 0 else [SCALE_NAMES[scale_i - 1]]
    root, scale = detect_key(src, roots, scales)
    pitches = scale_pitches(root, scale)

    # each stage has its own RNG -> tuning knobs never change the magic itself
    mel = src
    if strength > 0:
        mel = magic_pitches(mel, pitches, root, scale, ppq, strength, spread,
                            Rng(seed * 7 + 1))
    if rhythm != 0:
        mel = magic_rhythm(mel, rhythm, pitches, ppq, Rng(seed * 7 + 2))
    mel = ornament(mel, pitches, ppq, orn, Rng(seed * 7 + 3))

    # --- melody: no overlaps (mono lead)
    mel.sort(key=lambda n: (n['time'], n['number']))
    for i in range(len(mel) - 1):
        a = mel[i]
        for j in range(i + 1, len(mel)):
            b = mel[j]
            if b['time'] > a['time']:
                if a['time'] + a['length'] > b['time']:
                    a['length'] = max(1, b['time'] - a['time'])
                break
    min_len = max(1, ppq // 16)
    mel = [n for n in mel if n['length'] >= min_len or n['_k'] == 'main']

    # --- bounce (accents + humanize)
    if bounce > 0:
        rb = Rng(seed * 7 + 4)
        start = mel[0]['time']
        for n in mel:
            pos = (n['time'] - start) % ppq
            v = n.get('velocity', 0.8)
            if pos == 0:
                v *= 1 + 0.15 * bounce
            elif pos != ppq // 2:
                v *= 1 - 0.25 * bounce
            v *= 1 + (rb.next() - 0.5) * 0.1 * bounce
            n['velocity'] = clamp(v, 0.05, 1.0)

    # --- harmony
    harm_notes = []
    if harm:
        for n in mel:
            if n['_k'] == 'grace':
                continue
            p = n['number']
            if harm == 1:
                hp = step(pitches, p, 2)
            elif harm == 2:
                hp = step(pitches, p, -4)
            else:
                hp = clamp(p - 12, 0, 127)
            harm_notes.append(variant(n, number=hp,
                                      velocity=clamp(n.get('velocity', 0.8) * 0.75, 0.05, 1.0),
                                      _k='harm'))

    for n in mel + harm_notes:
        n['time'] = int(max(0, n['time']))
        n['length'] = int(max(1, n['length']))
        note = make_note(n)
        if any_sel:
            note.selected = True  # result stays selected
        score.addNote(note)
